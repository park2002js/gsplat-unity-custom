// Gsplat의 물리 충돌 연산 및 시뮬레이션을 위해 생성한 Compute Shader이다.
#pragma kernel BroadPhaseKernel
#pragma kernel NarrowPhaseBVHTraversalKernel
/*
#pragma kernel NarrowPhaseMahalanobisKernel
*/

#pragma kernel NarrowPhaseForRigidBodyData


// ==========================================================
// 1. 데이터 구조체 정의 (메모리 레이아웃)
// ==========================================================
// C#의 BVHNode1D 구조체와 정확히 일치하는 32바이트(16바이트 덩어리 2개) 구조체 정의
struct BVHNode1D
{
    float3 boundsMin; // 12 바이트
    int data1;        // 4 바이트 (왼쪽 자식 인덱스 or 가우시안 시작 인덱스)
    
    float3 boundsMax; // 12 바이트
    int data2;        // 4 바이트 (오른쪽 자식 인덱스 or 음수화된 가우시안 개수)
};

// 메타데이터: N개의 Gsplat 객체가 _BVHBuffer의 어디서 시작하는지 알려주는 메타데이터
struct GsplatMetaData {
    uint startIndex;    // 시작 인덱스
    uint nodeCount;     // 해당 Gspat 객체의 BVH 노드 총 수
    uint gaussianStartIndex; // 가우시안 속성 배열의 시작 인덱스
    uint gaussianCount;     // 가우시안의 총 개수
    float4x4 worldToLocal; // 다중 객체 대응을 위해, 각각의 충돌체마다 Local 공간 변환 행렬이 필요
    float4x4 localToWorld; // 가중 평균된 Leaf node의 Local Position을 World로 되돌릴 때 사용
};

// AABB 충돌 검사를 위한 구조체
struct AABBData {
    float3 center;  // AABB 박스의 중심점
    float3 extents; // AABB 박스의 모서리가 중심으로부터 얼마나 멀어졌는지 알려주는 정보
};

// RigidBody의 World 좌표계 OBB 정보
struct RigidbodyOBB {
    float3 center;
    float3 extents;
    float3 axisX;
    float3 axisY;
    float3 axisZ;
};

// ==========================================================
// 2. VRAM 데이터 버퍼 선언 (C#에서 바인딩할 대상들)
// ==========================================================
// 충돌 검사를 위한 버퍼 (Broad-phase 용)
StructuredBuffer<AABBData> _RBAABBBuffer;
StructuredBuffer<AABBData> _GaussianAABBBuffer;
AppendStructuredBuffer<uint2> _ActivePairsWriteBuffer; // 겹친 오브젝트 쌍(rbIndex, gsIndex)을 담을 버퍼

// CPU에서 넘겨준 활성화된 객체의 개수
uint _RBCount;
uint _GaussianCount;


// BVH 트리 탐색을 위한 버퍼 (Narrow-phase 용)
StructuredBuffer<uint2> _ActivePairsReadBuffer;  // appendStructuredBuffer는 읽기 불가하므로 읽기용 버퍼 생성
StructuredBuffer<BVHNode1D> _BVHBuffer;
StructuredBuffer<GsplatMetaData> _MetaDataBuffer;
StructuredBuffer<RigidbodyOBB> _RBOBBBuffer;

// 정밀 충돌 판정(Narrow-phase)을 위한 개별 가우시안 속성 버퍼 3종
StructuredBuffer<float3> _PhysPositionBuffer;
StructuredBuffer<float4> _PhysRotationBuffer;
StructuredBuffer<float3> _PhysScaleBuffer;

// CPU로 물리 연산 결과를 다시 돌려보내기 위한 Append 버퍼
// RW을 사용할 수 있었지만, 현재의 충돌 확인 과정에서는 실제로 이 버퍼의 길이를 알 수 없기 때문에
// Append로 유동적으로 대처 가능하도록 설정함. RW도 가능은 하지만 별도의 MaxIndex를 알리는 변수를 공유해야 함

// BVH 트리 탐색 결과인 충돌체 정보와 리프 노드의 인덱스(총 uint2)를 반환하기 위한 버퍼
AppendStructuredBuffer<uint3> _BVHTraversalResultWriteBuffer;
uint _OverlapCount; // CPU에서 넘겨줄 현재 프레임의 충돌 쌍 개수

// 마할라노비스 거리 계산을 하기 위해서, BVH 트리 탐색 결과를 읽기 위한 버퍼
StructuredBuffer<uint3> _BVHTraversalResultReadBuffer;

// ==========================================================
// [Debug] 테스트 용도의 구조체, 변수, 함수들 처리
// ==========================================================

/*
// [기존 NarrowPhaseMahalanobisKernel 전용] Normal Vector 출력
struct dispatch3testData {
    float3 position;
    float3 normal;
};
AppendStructuredBuffer<dispatch3testData> _Dispatch3TestResultBuffer;
*/

// 0 ~ 3 사이로 실시간 조절될 임계값
float _DistanceThreshold; 


// ==========================================================
// 3. 헬퍼 함수들
// ==========================================================

/// OBB-AABB 박스 충돌 교차 판정을 위한 변수 및 함수
// 두 AABB 간의 단순 교차 판정 함수
bool IntersectAABB(float3 minA, float3 maxA, float3 minB, float3 maxB)
{
    return (minA.x <= maxB.x && maxA.x >= minB.x) &&
           (minA.y <= maxB.y && maxA.y >= minB.y) &&
           (minA.z <= maxB.z && maxA.z >= minB.z);
}

// 분리축 정리(SAT)를 이용한 OBB vs AABB 교차 판정 함수 (AI의 도움을 받음)
bool IntersectOBBAABB(float3 aabbMin, float3 aabbMax, float3 localCenter, float3 localExtents, float3 localAxisX, float3 localAxisY, float3 localAxisZ)
{
    float3 aabbCenter = (aabbMax + aabbMin) * 0.5f;
    float3 aabbExtents = (aabbMax - aabbMin) * 0.5f;
    float3 d = aabbCenter - localCenter;

    if (abs(d.x) > aabbExtents.x + localExtents.x * abs(localAxisX.x) + localExtents.y * abs(localAxisY.x) + localExtents.z * abs(localAxisZ.x)) return false;
    if (abs(d.y) > aabbExtents.y + localExtents.x * abs(localAxisX.y) + localExtents.y * abs(localAxisY.y) + localExtents.z * abs(localAxisZ.y)) return false;
    if (abs(d.z) > aabbExtents.z + localExtents.x * abs(localAxisX.z) + localExtents.y * abs(localAxisY.z) + localExtents.z * abs(localAxisZ.z)) return false;
    if (abs(dot(d, localAxisX)) > localExtents.x + aabbExtents.x * abs(localAxisX.x) + aabbExtents.y * abs(localAxisX.y) + aabbExtents.z * abs(localAxisX.z)) return false;
    if (abs(dot(d, localAxisY)) > localExtents.y + aabbExtents.x * abs(localAxisY.x) + aabbExtents.y * abs(localAxisY.y) + aabbExtents.z * abs(localAxisY.z)) return false;
    if (abs(dot(d, localAxisZ)) > localExtents.z + aabbExtents.x * abs(localAxisZ.x) + localExtents.y * abs(localAxisZ.y) + localExtents.z * abs(localAxisZ.z)) return false;
    
    return true;
}

/// 마할라노비스 거리 계산을 위한 함수
// 쿼터니언(x, y, z, w)을 사용하여 3D 벡터를 회전시키는 함수
float3 RotateVectorByQuaternion(float3 v, float4 q)
{
    float3 u = q.xyz;
    float s = q.w;
    return 2.0f * dot(u, v) * u + (s * s - dot(u, u)) * v + 2.0f * s * cross(u, v);
}

// // 데이터 로드(읽기) 헬퍼 함수
// // VRAM에 올라간 개별 가우시안의 위치, 회전, 스케일을 로컬 메모리(레지스터)로 가져오는 것을 돕는 API
// void LoadPhysicsSplatData(uint splatIndex, out float3 pos, out float4 rot, out float3 scale)
// {
//     pos   = _PhysPositionBuffer[splatIndex];
//     rot   = _PhysRotationBuffer[splatIndex];
//     scale = _PhysScaleBuffer[splatIndex];
// }



// ==========================================================
// 4. 커널 (GPU 실행 진입점)
// ==========================================================
// Broad Phase (AABB 교차 검사)
// X축은 Rigidbody 인덱스, Y축은 Gsplat 인덱스를 맡아 N:M 쌍을 병렬로 검사합니다.
[numthreads(8, 8, 1)]
void BroadPhaseKernel (uint3 id : SV_DispatchThreadID)
{
    // 스레드 ID가 유효한 객체 개수를 초과하면 연산 취소 (Out of bounds 방지)
    if (id.x >= _RBCount || id.y >= _GaussianCount) return;

    // 1. 자신의 스레드 ID에 해당하는 AABB 데이터 로드
    AABBData rbAABB = _RBAABBBuffer[id.x];
    AABBData gsAABB = _GaussianAABBBuffer[id.y];

    // 2. center/extents 정보를 기반으로 min/max 데이터로 변환하여 AABB 검사에 사용
    float3 minA = rbAABB.center - rbAABB.extents;
    float3 maxA = rbAABB.center + rbAABB.extents;
    
    float3 minB = gsAABB.center - gsAABB.extents;
    float3 maxB = gsAABB.center + gsAABB.extents;

    // 3. AABB 교차 판정
    if (IntersectAABB(minA, maxA, minB, maxB))
    {
        // 겹침이 확인되면 해당 스레드가 담당한 인덱스 쌍을 Append
        _ActivePairsWriteBuffer.Append(uint2(id.x, id.y));
    }
}

// Narrow Phase 1 : (BVH 트리 탐색)
// 충돌 쌍이 담긴 배열을 1차원으로 쭉 훑으면서 탐색하므로 (32,1,1) 형태의 1D 스레드를 사용합니다.
[numthreads(32, 1, 1)]
void NarrowPhaseBVHTraversalKernel (uint3 id : SV_DispatchThreadID)
{
    // 스레드 아이디가 실제 충돌 쌍 개수보다 크면 종료
    if (id.x >= _OverlapCount) return;

    // 1. Broad Phase가 찾아낸 충돌 쌍 정보 가져오기
    uint2 pair = _ActivePairsReadBuffer[id.x];
    uint rbIndex = pair.x;
    uint gsIndex = pair.y;

    RigidbodyOBB rbOBB = _RBOBBBuffer[rbIndex];
    GsplatMetaData meta = _MetaDataBuffer[gsIndex];

    // 2. RigidBody의 World OBB를 대상 Gsplat의 Local 공간으로 역변환 연산
    float3 localCenter = mul(meta.worldToLocal, float4(rbOBB.center, 1.0f)).xyz;
    float3 localAxisX  = normalize(mul(meta.worldToLocal, float4(rbOBB.axisX, 0.0f)).xyz);
    float3 localAxisY  = normalize(mul(meta.worldToLocal, float4(rbOBB.axisY, 0.0f)).xyz);
    float3 localAxisZ  = normalize(mul(meta.worldToLocal, float4(rbOBB.axisZ, 0.0f)).xyz);
    
    // 크기는 Scale에 의해 왜곡될 수 있으므로 별도 계산
    // 오브젝트의 Scale을 행렬에서 추출하려면, 변환 행렬을 구성하는 3개의 기저 벡터에 해당하는 행렬의 '열 벡터'의 길이를 구해야 함
    // HLSL에서 특정 행렬의 '행'을 추출하는 수학적 방법은 행 벡터를 앞에 곱하는 것이므로 mul(vector, matrix) 순서로 곱한다.
    float3 scaleVector = float3(
        length(mul(meta.worldToLocal, float4(1,0,0,0))), 
        length(mul(meta.worldToLocal, float4(0,1,0,0))), 
        length(mul(meta.worldToLocal, float4(0,0,1,0)))
    );
    float3 localExtents = rbOBB.extents * scaleVector;

    // 3. 로컬 스택 선언 및 초기화
    // Computer Shader에서는 재귀 함수를 사용하지 못하므로 스택 자료구조를 사용해서 탐색
    // HLSL 로컬 메모리를 이용한 스택 선언 (GsplatAssetPhysics.cs 내에 정의된 depth 정책(최대 깊이 24)에서 좀 더 여유를 둠)
    uint stack[32];
    int stackPtr = 0;

    // 루트 노드 인덱스 0번 추가
    stack[stackPtr++] = 0; 
    
    // 4. 깊이 우선 탐색 로직 시작
    while(stackPtr > 0)
    {
        // 최상단 노드 추출
        uint localNodeIdx = stack[--stackPtr];
        
        // BVH 버퍼 상의 실제 절대 주소 계산
        uint globalNodeIdx = meta.startIndex + localNodeIdx;
        BVHNode1D node = _BVHBuffer[globalNodeIdx];
        
        // 역변환된 OBB 데이터를 이용해 교차 검사 실행
        if(IntersectOBBAABB(node.boundsMin, node.boundsMax, localCenter, localExtents, localAxisX, localAxisY, localAxisZ))
        {
            if(node.data2 <= 0) // 리프 노드인 경우
            {
                // 리프 노드에 도달하면 어떤 RigidBody가 BVH의 어떤 Leaf 노드와 부딪혔는지 기록
                // rbIndex : 충돌을 일으킨 외부 RigidBody의 인덱스
                // gsIndex : 충돌 대상 Gsplat 오브젝트 인덱스
                // globalNodeIdx : 충돌 가능성이 있다 판정된 BVH의 Leaf Node 인덱스
                _BVHTraversalResultWriteBuffer.Append(uint3(rbIndex, gsIndex, globalNodeIdx)); 
            }
            else // 내부(Internal) 노드인 경우: 자식 노드들을 스택에 Push
            {
                // 스택 오버플로우 방지 : 30인 이유는 위에서 uint stack[32]인 것과, 그리고 내부 노드를 만나면 한번에 2개의 데이터를 Push하기 때문
                if(stackPtr < 30) 
                {
                    stack[stackPtr++] = node.data1; 
                    stack[stackPtr++] = node.data2; 
                }
            }
        }
    }
}


// Narrow Phase 2 : (마할라노비스 거리 탐색)
// Leaf Node 정보가 담긴 배열의 원소에 있는 최대 32개의 가우시안을 담당하여 계산하기 위해 (32,1,1) 형태의 1D 스레드를 사용합니다.

/*
// 그룹 내의 32개 Thread가 공용으로 사용할 누적 메모리
groupshared int sharedNormX;
groupshared int sharedNormY;
groupshared int sharedNormZ;
groupshared int sharedPosX;
groupshared int sharedPosY;
groupshared int sharedPosZ;
groupshared int sharedWeightSum;

// Gsplat 인덱스를 기준으로 힘(법선)을 누적할 RW 버퍼 (int3 사용)
// Append가 아닌 RW 버퍼를 쓴 이유는 정확한 gsIndex 주소에 맞춰서 결과를 업데이트 해주어야 했기 때문
RWStructuredBuffer<int3> _GsplatForceOutputBuffer;

[numthreads(32, 1, 1)]
void NarrowPhaseMahalanobisKernel(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    // 1. 0번 Thread가 그룹 공유 메모리 초기화
    if (groupThreadID.x == 0)
    {
        sharedNormX = 0; sharedNormY = 0; sharedNormZ = 0;
        sharedPosX = 0; sharedPosY = 0; sharedPosZ = 0;
        sharedWeightSum = 0;
    }

    // 그 그룹 내의 모든 Thread가 초기화를 기다리도록 동기화
    GroupMemoryBarrierWithGroupSync();

    // 2. 변경된 Read 버퍼에서 현재 그룹이 담당할 충돌 쌍 정보(RigidBody 인덱스, Global Node 인덱스) 가져오기, groupID.x가 충돌 쌍의 인덱스에 해당
    uint3 pair = _BVHTraversalResultReadBuffer[groupID.x];
    uint rbIndex = pair.x;
    uint gsIndex = pair.y;
    uint globalNodeIdx = pair.z;

    BVHNode1D node = _BVHBuffer[globalNodeIdx];

    // 3. 리프 노드 내부의 가우시안 데이터 접근
    if (node.data2 <= 0) 
    {
        uint gaussianStartIdx = node.data1;
        uint gaussianCount = (uint)(-node.data2); 

        // 자신의 Thread ID가 가우시안 개수 이내일 때만 연산 참여
        if (groupThreadID.x < gaussianCount)
        {
            // meta.gaussianStartIndex 오프셋을 더해줌으로써 다른 객체의 가우시안을 침범하지 않도록 함.
            GsplatMetaData meta = _MetaDataBuffer[gsIndex];
            uint myGaussianIndex = meta.gaussianStartIndex + gaussianStartIdx + groupThreadID.x;

            // ====================마할라노비스 거리 연산====================
            
            //GsplatMetaData meta = _MetaDataBuffer[gsIndex];
            RigidbodyOBB rbOBB = _RBOBBBuffer[rbIndex];

            // 1. OBB 정보를 Gsplat Local 공간으로 역변환 
            float3 localCenter = mul(meta.worldToLocal, float4(rbOBB.center, 1.0f)).xyz;
            float3 localAxisX  = normalize(mul(meta.worldToLocal, float4(rbOBB.axisX, 0.0f)).xyz);
            float3 localAxisY  = normalize(mul(meta.worldToLocal, float4(rbOBB.axisY, 0.0f)).xyz);
            float3 localAxisZ  = normalize(mul(meta.worldToLocal, float4(rbOBB.axisZ, 0.0f)).xyz);

            // 크기는 Scale에 의해 왜곡될 수 있으므로 별도 계산 
            float3 scaleVector = float3(
                length(mul(meta.worldToLocal, float4(1,0,0,0))), 
                length(mul(meta.worldToLocal, float4(0,1,0,0))), 
                length(mul(meta.worldToLocal, float4(0,0,1,0)))
            );
            float3 localExtents = rbOBB.extents * scaleVector;

            // 2. 가우시안 데이터 추출
            float3 gPos = _PhysPositionBuffer[myGaussianIndex];
            float4 gRot = _PhysRotationBuffer[myGaussianIndex];
            float3 gScale = _PhysScaleBuffer[myGaussianIndex];

            // 3. 가우시안 중심점에서 OBB 중심점으로 향하는 벡터
            float3 d = gPos - localCenter;

            // 4. 이 벡터를 OBB의 3개 축에 각각 투영하여 거리를 측정, 이때 OBB의 상자 크기(Extents) 안으로 강제 절삭(Clamp)하여 수선의 발을 구함
            float distX = clamp(dot(d, localAxisX), -localExtents.x, localExtents.x);
            float distY = clamp(dot(d, localAxisY), -localExtents.y, localExtents.y);
            float distZ = clamp(dot(d, localAxisZ), -localExtents.z, localExtents.z);

            // 5. Closest Point (OBB 표면에서 가우시안과 가장 가까운 점) 획득
            float3 closestPointLocal = localCenter + distX * localAxisX + distY * localAxisY + distZ * localAxisZ;

            // 6. 이동 취소 (Un-translate) : 가우시안 중심을 원점으로 만듦. 가우시안 중심(gPos)과 방금 찾은 수선의 발(closestPointLocal)의 차이로 구현
            float3 deltaPos = closestPointLocal - gPos;

            // 7. 회전 취소 (Un-rotate) : 쿼터니언의 켤레(Conjugate)를 이용해 역회전
            float4 qInv = float4(-gRot.x, -gRot.y, -gRot.z, gRot.w);
            float3 localDelta = RotateVectorByQuaternion(deltaPos, qInv);

            // 8. 스케일 취소 (Un-scale) : 축별로 찌그러진 타원체를 구(Sphere)로 폄
            float3 scaledDelta = localDelta / max(gScale, 0.00001f);

            // 9. 최종 마할라노비스 거리 : 타원 공간을 구형 공간으로 폈으므로, 이 벡터의 길이가 곧 마할라노비스 거리(Sigma)가 됨
            float myDistance = length(scaledDelta);

            // ==========================================================
            

            if (myDistance <= _DistanceThreshold)
            {
                // ===================Normal Vector 연산====================
                // 1. Scale 값 중 가장 작은 값을 가지는 로컬 축(X, Y, Z) 찾기
                float3 localAxis;
                if (gScale.x <= gScale.y && gScale.x <= gScale.z) {
                    localAxis = float3(1, 0, 0);
                } else if (gScale.y <= gScale.x && gScale.y <= gScale.z) {
                    localAxis = float3(0, 1, 0);
                } else {
                    localAxis = float3(0, 0, 1);
                }

                // 2. 찾아낸 로컬 축을 가우시안의 회전값(gRot)으로 회전시켜 Gsplat Local 공간의 Normal로 변환
                float3 myLocalNormal = RotateVectorByQuaternion(localAxis, gRot);

                // 3. Normal 방향 보정 (OBB를 향하도록)
                // 가우시안 타원의 축은 앞/뒤 구분이 없으므로, OBB 중심(localCenter)을 향하는 방향과 내적하여 반대를 보고 있다면 뒤집어줍니다.
                float3 dirToClosest = closestPointLocal - gPos;
                if (dot(myLocalNormal, dirToClosest) < 0) {
                    myLocalNormal = -myLocalNormal;
                }

                // 4. World 공간의 Normal로 변환하여 최종 정규화
                // world 좌표계의 Normal을 구하기 위해서는 "'Local 좌표계를 World 좌표계로 변환하는 변환 행렬(L2W)'의 역행렬(^-1)의 전치 행렬(^T)"를 곱해야 한다. = (L2W^-1)^T
                // 역행렬 전치를 곱해야 하는 이유는, "비균등 스케일"때문이다. 여기서 "역행렬"은 L2W대신 W2L을 곱하는 것으로, 전치는 순서를 뒤집는 것으로 적용하여, 결과적으로는 mul(v,M)으로 한다.
                float3 worldNormal = normalize(mul(myLocalNormal, (float3x3)meta.worldToLocal));
                // ==========================================================
                
                // ===================가중합 누적====================
                // 거리를 역수로 취하여 거리가 짧을수록 가중치가 커지도록 설정
                // 거리가 0일 때 무한대가 되는 것을 방지하기 위해 입실론을 더함, 여기서는 (0.0001f)으로 설정
                float myWeight = 1.0f / (myDistance + 0.0001f);
                float3 weightedNormal = worldNormal * myWeight;
                float3 weightedPos = gPos * myWeight; // 가우시안의 위치(gPos)도 가중치를 곱함
                
                // float 형태의 데이터를 InterlockedAdd 함수에 쓰기 위한 고정 소수점 스케일 변환
                int scale = 10000;

                // 레이스 컨디션 없이 안전하게 32개의 데이터를 원자적 누적
                InterlockedAdd(sharedNormX, (int)(weightedNormal.x * scale));
                InterlockedAdd(sharedNormY, (int)(weightedNormal.y * scale));
                InterlockedAdd(sharedNormZ, (int)(weightedNormal.z * scale));
                InterlockedAdd(sharedPosX, (int)(weightedPos.x * scale));
                InterlockedAdd(sharedPosY, (int)(weightedPos.y * scale));
                InterlockedAdd(sharedPosZ, (int)(weightedPos.z * scale));
                InterlockedAdd(sharedWeightSum, (int)(myWeight * scale));
            }
        }
    }

    // 6. 그룹 내의 32개의 Thread가 원자적 누적 연산을 모두 마칠 때까지 대기
    GroupMemoryBarrierWithGroupSync();

    // 7. 0번 Thread가 그룹을 대표하여 최종 Normal 계산 및 버퍼 출력
    if (groupThreadID.x == 0 && sharedWeightSum > 0)
    {
        float scaleFloat = 10000.0f;
        float totalWeight = (float)sharedWeightSum / scaleFloat;

        // 정규화된 최종 Normal Vector
        float3 finalNormal = float3(sharedNormX, sharedNormY, sharedNormZ) / scaleFloat;
        finalNormal = normalize(finalNormal / totalWeight);


        // 물리 시뮬레이션 계산을 위해, 최종 Normal Vector들 값을, 중앙 관리를 위해 Gsplat 고유 ID(gsIndex)에 법선 벡터 값을 누적
        int scale = 10000; // InterLockedAdd는 정수형만 지원하므로, float 형태의 노말 백터를 정수형으로 강제 스케일링
        InterlockedAdd(_GsplatForceOutputBuffer[gsIndex].x, (int)(finalNormal.x * scale)); // InterLockedAdd를 통해 원자성 보장
        InterlockedAdd(_GsplatForceOutputBuffer[gsIndex].y, (int)(finalNormal.y * scale));
        InterlockedAdd(_GsplatForceOutputBuffer[gsIndex].z, (int)(finalNormal.z * scale));

        
        // 정규화된 최종 Local Position (가중 평균)
        float3 finalLocalPos = float3(sharedPosX, sharedPosY, sharedPosZ) / scaleFloat;
        finalLocalPos /= totalWeight;

        // 가중합으로 구해진 Local Position을 World Position으로 변환
        GsplatMetaData meta = _MetaDataBuffer[gsIndex];
        // 위에서의 World To Local 좌표계 변환처럼, Local To World 역시 mul(vector, matrix) 형태가 되어야 한다.
        float3 finalWorldPos = mul(meta.localToWorld, float4(finalLocalPos, 1.0f)).xyz;

        dispatch3testData resultData;
        resultData.position = finalWorldPos;
        resultData.normal = finalNormal;

        _Dispatch3TestResultBuffer.Append(resultData);
    }
}
*/

// Rigidbody 적용용 결과. position은 Rigidbody가 있으면 접촉점,
// 없으면 fallback Gizmo에 사용할 충돌 Gaussian 중심점입니다.
struct rigidBodyData
{
    uint rbIndex;
    uint gsIndex;
    float3 position;
    float3 normal;
    float penetration;
};

StructuredBuffer<uint> _GsplatHasRigidbodyBuffer;
AppendStructuredBuffer<rigidBodyData> _GsplatForceOutputBuffer;

groupshared int rigidBodyNormX;
groupshared int rigidBodyNormY;
groupshared int rigidBodyNormZ;
groupshared int rigidBodyPosX;
groupshared int rigidBodyPosY;
groupshared int rigidBodyPosZ;
groupshared int rigidBodyWeightSum;
groupshared int rigidBodyDistanceSum;
groupshared int rigidBodyHitCount;

[numthreads(32, 1, 1)]
void NarrowPhaseForRigidBodyData(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    // 1. 스레드 그룹이 공유하는 누적값을 명시적으로 초기화
    if (groupThreadID.x == 0)
    {
        rigidBodyNormX = 0; // 법선 누적들 
        rigidBodyNormY = 0;
        rigidBodyNormZ = 0;

        rigidBodyPosX = 0;  // 접촉 위치 누적들
        rigidBodyPosY = 0;
        rigidBodyPosZ = 0;

        rigidBodyWeightSum = 0; // 가중치 합
        rigidBodyDistanceSum = 0;   // 거리 합
        rigidBodyHitCount = 0;  // 충돌 가우시안 수 
    }

    GroupMemoryBarrierWithGroupSync();  // 각 스레드 그룹에서 0번 스레드만 초기화를 진행하고, 나머지 스레드는 초기화를 대기 함

    // 2. 스레드가 처리할 데이터를 각 스레드마다 할당
    uint3 pair = _BVHTraversalResultReadBuffer[groupID.x]; // 스레드 별 데이터 분리
    uint rbIndex = pair.x;  // 외부 Rigid Body 정보를 얻기 위한 인덱스
    uint gsIndex = pair.y;  // Gsplat 오브젝트 정보를 얻기 위한 인덱스
    uint globalNodeIdx = pair.z;    // BVH 리프 노드 정보를 얻기 위한 인덱스
    BVHNode1D node = _BVHBuffer[globalNodeIdx];

    // 리프 노드의 정보이면 node의 data2 값이 0 이하임
    if (node.data2 <= 0)
    {
        uint gaussianStartIdx = node.data1; // 가우시안 인덱스 정보
        uint gaussianCount = (uint)(-node.data2); // 각 스레드에게 맡길 가우시안의 총 수

        if (groupThreadID.x < gaussianCount)
        {
            GsplatMetaData meta = _MetaDataBuffer[gsIndex];
            // 3. 각 스레드는 myGaussianIndex 정보를 하나씩 맡음
            uint myGaussianIndex = meta.gaussianStartIndex + gaussianStartIdx + groupThreadID.x;

            // 4. 외부 RigidBody OBB를 Gsplat의 로컬 좌표로 변환 (BVH는 Gsplat의 로컬 공간에 잇으나, 외부 Rigid Body는 월드 공간에 존재함)
            // mul 순서는 W2L 변환 좌표가 앞에, 그 뒤에 Transform 정보가 와야 함
            RigidbodyOBB rbOBB = _RBOBBBuffer[rbIndex];
            float3 localCenter = mul(meta.worldToLocal, float4(rbOBB.center, 1.0f)).xyz;
            float3 localAxisX = normalize(mul(meta.worldToLocal, float4(rbOBB.axisX, 0.0f)).xyz);  
            float3 localAxisY = normalize(mul(meta.worldToLocal, float4(rbOBB.axisY, 0.0f)).xyz);
            float3 localAxisZ = normalize(mul(meta.worldToLocal, float4(rbOBB.axisZ, 0.0f)).xyz);
            // 크기는 Scale에 의해 왜곡될 수 있으므로 별도 계산 
            float3 scaleVector = float3(
                length(mul(meta.worldToLocal, float4(1, 0, 0, 0))),
                length(mul(meta.worldToLocal, float4(0, 1, 0, 0))),
                length(mul(meta.worldToLocal, float4(0, 0, 1, 0)))
            );
            float3 localExtents = rbOBB.extents * scaleVector;

            // 5. Gaussian 중심에서 OBB까지 가장 가까운 점까지의 거리를 계산을 위한 과정
            // 가우시안 데이터 추출
            float3 gPos = _PhysPositionBuffer[myGaussianIndex];
            float4 gRot = _PhysRotationBuffer[myGaussianIndex];
            float3 gScale = _PhysScaleBuffer[myGaussianIndex];
            
            // 6. 가우시안 중심점에서 OBB 중심점으로 향하는 벡터 계산
            float3 d = gPos - localCenter;
            
            // 7. 위에서 구한 벡터(d)를 OBB의 3개 축에 각각 투영하여 거리를 측정, 이때 OBB의 상자 크기(Extents) 안으로 강제 절삭(Clamp)하여 수선의 발을 구함
            float distX = clamp(dot(d, localAxisX), -localExtents.x, localExtents.x);
            float distY = clamp(dot(d, localAxisY), -localExtents.y, localExtents.y);
            float distZ = clamp(dot(d, localAxisZ), -localExtents.z, localExtents.z);
            // 8. Closest Point (OBB 표면에서 가우시안과 가장 가까운 점) 획득
            float3 closestPointLocal = localCenter + distX * localAxisX + distY * localAxisY + distZ * localAxisZ;
            
            // 9. 가우시안 중심(gPos)에서 OBB 최근접 점(closestPointLocal)으로 향하는 벡터를 구함
            float3 deltaPos = closestPointLocal - gPos;
            
            // 10. 회전 취소 (Un-rotate) : 위에서 구한 벡터에 쿼터니언의 켤레(Conjugate)를 이용해 역회전을 적용해서 Gaussian의 주축 공간으로 옮김
            float4 qInv = float4(-gRot.x, -gRot.y, -gRot.z, gRot.w);
            float3 localDelta = RotateVectorByQuaternion(deltaPos, qInv);

            // 11. 스케일 취소 (Un-scale) : 축별로 찌그러진 타원체를 구(Sphere)로 폄
            float3 scaledDelta = localDelta / max(gScale, 0.00001f);

            // 12. 최종 마할라노비스 거리 : 위의 정규화 과정을 거친 정규화된 공간에서 거리를 측정. 타원 공간을 구형 공간으로 폈으므로, 이 벡터의 길이가 곧 마할라노비스 거리(Sigma)가 됨
            // 또한 myDistance는 미터 단위 거리가 아닌 Sigma 단위이므로 임계값과 비교 가능
            float myDistance = length(scaledDelta);
            
            // ===================Normal Vector 연산====================
            // Sigma 단위 임계값과 비교하여, 해당 값보다 이하라면 "충돌"한 것으로 간주
            if (myDistance <= _DistanceThreshold)
            {
                // 13. 가우시안의 Scale 값 중 가장 작은 값을 가지는 로컬 축(X, Y, Z)을 찾아서 표면 법선 후보로 선택
                float3 localAxis;
                if (gScale.x <= gScale.y && gScale.x <= gScale.z)
                    localAxis = float3(1, 0, 0);
                else if (gScale.y <= gScale.x && gScale.y <= gScale.z)
                    localAxis = float3(0, 1, 0);
                else
                    localAxis = float3(0, 0, 1);

                // 14. 찾아낸 로컬 축을 가우시안의 회전값(gRot)으로 회전시켜 Gsplat Local 공간의 Normal로 변환
                float3 myLocalNormal = RotateVectorByQuaternion(localAxis, gRot);

                // 15. Normal 방향 보정 (OBB의 중심 방향을 향하도록 부호 보정)
                // 가우시안 타원의 축은 앞/뒤 구분이 없으므로, OBB 중심(localCenter)을 향하는 방향과 내적하여 반대를 보고 있다면 뒤집음
                float3 dirToClosest = closestPointLocal - gPos;
                if (dot(myLocalNormal, dirToClosest) < 0)
                    myLocalNormal = -myLocalNormal;
                
                // 16. Local의 법선을, World 공간의 Normal로 변환하여 최종 정규화
                // world 좌표계의 Normal을 구하기 위해서는 "'Local 좌표계를 World 좌표계로 변환하는 변환 행렬(L2W)'의 역행렬(^-1)의 전치 행렬(^T)"를 곱해야 한다. = (L2W^-1)^T
                // 역행렬 전치를 곱해야 하는 이유는, "비균등 스케일"때문이다. 여기서 "역행렬"은 L2W대신 W2L을 곱하는 것으로, 전치는 순서를 뒤집는 것으로 적용하여, 결과적으로는 mul(v,M)으로 한다.
                float3 worldNormal = normalize(mul(myLocalNormal, (float3x3)meta.worldToLocal));
                
                // 17. 가중합 누적
                // 거리를 역수로 취하여 거리가 짧을수록 가중치가 커지도록 설정 (거리가 0일 때 무한대가 되는 것을 방지하기 위해 입실론을 더함, 여기서는 (0.0001f)으로 설정)
                float myWeight = min(1.0f / (myDistance + 0.0001f), 1000.0f);

                // 18. Gsplat에 Rigid body 존재 여부에 따라 결과 달라짐 : RB 존재 = OBB 최근접점을 힘 적용 위치로 사용(closet..) / RB 없음 = Gaussian 중심을 Gizmo 위치로 사용(gPos)
                float3 outputPositionLocal = _GsplatHasRigidbodyBuffer[gsIndex] != 0 ? closestPointLocal : gPos;
                
                // 19. 각 충돌점마다 가중합 누적
                float3 weightedNormal = worldNormal * myWeight;
                float3 weightedPosition = outputPositionLocal * myWeight;

                const int scale = 1000; // float 형태의 데이터를 InterlockedAdd 함수에 쓰기 위한 고정 소수점 스케일 변환
                InterlockedAdd(rigidBodyNormX, (int)(weightedNormal.x * scale)); // 레이스 컨디션 없이 안전하게 원자적 누적하기 위해서 InterlockedAdd
                InterlockedAdd(rigidBodyNormY, (int)(weightedNormal.y * scale));
                InterlockedAdd(rigidBodyNormZ, (int)(weightedNormal.z * scale));
                InterlockedAdd(rigidBodyPosX, (int)(weightedPosition.x * scale));
                InterlockedAdd(rigidBodyPosY, (int)(weightedPosition.y * scale));
                InterlockedAdd(rigidBodyPosZ, (int)(weightedPosition.z * scale));
                InterlockedAdd(rigidBodyWeightSum, (int)(myWeight * scale));
                InterlockedAdd(rigidBodyDistanceSum, (int)(myDistance * scale));
                InterlockedAdd(rigidBodyHitCount, 1);
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();  // 모든 스레드가 준비될 때까지 대기

    // 0번 스레드만 최종 결과를 만들어 냄
    if (groupThreadID.x == 0 && rigidBodyWeightSum > 0 && rigidBodyHitCount > 0)
    {
        // const float scale = 1000.0f;
        // 20. 대표 법선을 구하기 위해 총 가중치를 복원
        // float totalWeight = (float)rigidBodyWeightSum / scale;
        
        // 21. 법선 복구 한 뒤 가중치로 정규화 하여, 가중치가 적용된 대표 법선 구함
        float3 finalNormal = normalize(float3(rigidBodyNormX, rigidBodyNormY, rigidBodyNormZ) / rigidBodyWeightSum);
        // 22. 가중치가 적용된 대표 위치를 계산 
        float3 finalLocalPosition = float3(rigidBodyPosX, rigidBodyPosY, rigidBodyPosZ) / rigidBodyWeightSum; // (scale * totalWeight);

        GsplatMetaData meta = _MetaDataBuffer[gsIndex];

        // 23. 결과 반환을 위해 데이터들 저장
        rigidBodyData resultData;
        resultData.rbIndex = rbIndex; // rigid body 구분
        resultData.gsIndex = gsIndex; // Gsplat 구분

        // 대표 위치를 월드 좌표로 변환한 뒤 저장 : 위에서의 World To Local 좌표계 변환처럼, Local To World 역시 mul(vector, matrix) 형태가 되어야 한다.
        resultData.position = mul(meta.localToWorld, float4(finalLocalPosition, 1.0f)).xyz;
        // 대표 법선도 저장
        resultData.normal = finalNormal;

        // Rigid Body가 시뮬레이션 하기 위해서 침투값 계산
        float averageDistance = (float)rigidBodyDistanceSum / ((float)rigidBodyHitCount * 1000.0f);
        resultData.penetration = max(0.0f, _DistanceThreshold - averageDistance);

        _GsplatForceOutputBuffer.Append(resultData);
    }
}
