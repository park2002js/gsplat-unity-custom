// Gsplat의 물리 충돌 연산 및 시뮬레이션을 위해 생성한 Compute Shader이다.
// 커널(진입점)의 이름은 PhysicsKernel
#pragma kernel PhysicsKernel

// ==========================================================
// 1. 데이터 구조체 정의 (메모리 레이아웃)
// ==========================================================
// C#의 BVHNode1D 구조체와 정확히 일치하는 32바이트(16바이트 덩어리 2개) 구조체 정의
struct BVHNode1D
{
    float3 boundsMin; // 12 바이트
    int data1;        // 4 바이트 (왼쪽 자식 인덱스 or 가우시안 시작 인덱스)
    
    float3 boundsMax; // 12 바이트
    int data2;        // 4 바이트 (오른쪽 자식 인덱스 or 음수화된 가우시안 개수)
};

// ==========================================================
// 2. VRAM 데이터 버퍼 선언 (C#에서 바인딩할 대상들)
// ==========================================================
// BVH 트리 탐색을 위한 버퍼 (Broad-phase 용)
StructuredBuffer<BVHNode1D> _BVHBuffer;

// 정밀 충돌 판정(Narrow-phase)을 위한 개별 가우시안 속성 버퍼 3종
StructuredBuffer<float3> _PhysPositionBuffer;
StructuredBuffer<float4> _PhysRotationBuffer;
StructuredBuffer<float3> _PhysScaleBuffer;

// CPU로 물리 연산 결과를 다시 돌려보내기 위한 Append 버퍼
// RW을 사용할 수 있었지만, 현재의 충돌 확인 과정에서는 실제로 이 버퍼의 길이를 알 수 없기 때문에
// Append로 유동적으로 대처 가능하도록 설정함. RW도 가능은 하지만 별도의 MaxIndex를 알리는 변수를 공유해야 함
AppendStructuredBuffer<uint> _ResultLeafNodes;


// ==========================================================
// 3. OBB-AABB 박스 충돌 교차 판정을 위한 변수 및 함수
// ==========================================================
// C#에서 넘겨줄 Test Object의 중심값 및 회전 정보
float3 _StickCenter;
float3 _StickExtents; // x, y, z 반경 (Scale / 2)
float3 _StickAxisX;   // 로컬 X축 벡터
float3 _StickAxisY;   // 로컬 Y축 벡터
float3 _StickAxisZ;   // 로컬 Z축 벡터

// // 두 AABB 간의 단순 교차 판정 함수
// bool IntersectAABB(float3 minA, float3 maxA, float3 minB, float3 maxB)
// {
//     return (minA.x <= maxB.x && maxA.x >= minB.x) &&
//            (minA.y <= maxB.y && maxA.y >= minB.y) &&
//            (minA.z <= maxB.z && maxA.z >= minB.z);
// }

// 분리축 정리(SAT)를 이용한 OBB vs AABB 교차 판정 함수 (AI의 도움을 받음)
bool IntersectOBBAABB(float3 aabbMin, float3 aabbMax)
{
    float3 aabbCenter = (aabbMax + aabbMin) * 0.5f;
    float3 aabbExtents = (aabbMax - aabbMin) * 0.5f;

    // AABB 중심과 OBB(막대기) 중심 사이의 거리 벡터
    float3 d = aabbCenter - _StickCenter;

    // 1. AABB의 3축(X, Y, Z)에 투영하여 겹치는지 테스트
    if (abs(d.x) > aabbExtents.x + _StickExtents.x * abs(_StickAxisX.x) + _StickExtents.y * abs(_StickAxisY.x) + _StickExtents.z * abs(_StickAxisZ.x)) return false;
    if (abs(d.y) > aabbExtents.y + _StickExtents.x * abs(_StickAxisX.y) + _StickExtents.y * abs(_StickAxisY.y) + _StickExtents.z * abs(_StickAxisZ.y)) return false;
    if (abs(d.z) > aabbExtents.z + _StickExtents.x * abs(_StickAxisX.z) + _StickExtents.y * abs(_StickAxisY.z) + _StickExtents.z * abs(_StickAxisZ.z)) return false;

    // 2. OBB(막대기)의 3축에 투영하여 겹치는지 테스트
    if (abs(dot(d, _StickAxisX)) > _StickExtents.x + aabbExtents.x * abs(_StickAxisX.x) + aabbExtents.y * abs(_StickAxisX.y) + aabbExtents.z * abs(_StickAxisX.z)) return false;
    if (abs(dot(d, _StickAxisY)) > _StickExtents.y + aabbExtents.x * abs(_StickAxisY.x) + aabbExtents.y * abs(_StickAxisY.y) + aabbExtents.z * abs(_StickAxisY.z)) return false;
    if (abs(dot(d, _StickAxisZ)) > _StickExtents.z + aabbExtents.x * abs(_StickAxisZ.x) + aabbExtents.y * abs(_StickAxisZ.y) + aabbExtents.z * abs(_StickAxisZ.z)) return false;

    return true;
}


// // 데이터 로드(읽기) 헬퍼 함수
// // VRAM에 올라간 개별 가우시안의 위치, 회전, 스케일을 로컬 메모리(레지스터)로 가져오는 것을 돕는 API
// void LoadPhysicsSplatData(uint splatIndex, out float3 pos, out float4 rot, out float3 scale)
// {
//     pos   = _PhysPositionBuffer[splatIndex];
//     rot   = _PhysRotationBuffer[splatIndex];
//     scale = _PhysScaleBuffer[splatIndex];
// }

// ==========================================================
// 4. 메인 연산 로직 (진입점)
// ==========================================================
// 스레드 그룹 크기 설정 : 일반적으로 1D 배열 탐색 시 64, 256, 1024 단위를 사용하지만,
// 실제로 BVH 트리를 탐색하는 과정은 병렬화 할 수 없으므로, 부딪히는 물체 하나당 1개의 Thread를 사용해서 BVH 트리를 탐색함
[numthreads(1, 1, 1)]
void PhysicsKernel(uint3 id : SV_DispatchThreadID)
{
    // Computer Shader에서는 재귀 함수를 사용하지 못하므로 스택 자료구조를 사용해서 탐색
    // HLSL 로컬 메모리를 이용한 스택 선언 (GsplatAssetPhysics.cs 내에 정의된 depth 정책(최대 깊이 24)에서 좀 더 여유를 둠)
    uint stack[32];
    int stackPtr = 0;

    // 루트 노드(0번 인덱스)부터 탐색 시작
    stack[stackPtr++] = 0; 
    
    while(stackPtr > 0)
    {
        // Pop
        uint nodeIdx = stack[--stackPtr];
        BVHNode1D node = _BVHBuffer[nodeIdx];
        
        // 충돌하려는 외부 물체와 현재 노드의 AABB 교차 검사
        if(IntersectOBBAABB(node.boundsMin, node.boundsMax))
        {
            if(node.data2 <= 0) // 리프 노드인 경우
            {
                // 결과 버퍼에 노드 인덱스 추가
                _ResultLeafNodes.Append(nodeIdx);
            }
            else // 내부(Internal) 노드인 경우: 자식 노드들을 스택에 Push
            {
                // 스택 오버플로우 방지 : 30인 이유는 위에서 uint stack[32]인 것과, 그리고 내부 노드를 만나면 한번에 2개의 데이터를 Push하기 때문
                if(stackPtr < 30) 
                {
                    stack[stackPtr++] = node.data1; // 왼쪽 자식
                    stack[stackPtr++] = node.data2; // 오른쪽 자식
                }
            }
        }
    }
}
